#!/usr/bin/env bash
# Prints the current docker context's endpoint, so tools that need DOCKER_HOST explicitly
# (e.g. pulumi-docker-build) reach the same daemon the `docker` CLI is pointed at --
# colima, Docker Desktop, or a native daemon.
set -euo pipefail

host="$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null)"

if [[ -z "$host" ]]; then
  echo "Could not determine the docker context's endpoint. Is docker configured?" >&2
  exit 1
fi

printf '%s\n' "$host"
