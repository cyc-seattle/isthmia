#!/usr/bin/env bash
# Moves prod's apex record, `portal-a`, from `infrastructure`'s state into a new `portal` prod stack
# (#231, docs/prod-cutover-authentik-portal.md). Changes no cloud resource. A dry run by default;
# `--apply` performs it. Re-runnable: each step skips what's already done.
#
# Usage: move-portal-state [--apply]
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
stack=prod
source_stack="organization/infrastructure/$stack"
dest_stack="organization/portal/$stack"
urn="urn:pulumi:$stack::infrastructure::gcp:dns/recordSet:RecordSet::portal-a"
secrets_provider="gcpkms://projects/cyc-admin-scripts/locations/us-west1/keyRings/pulumi/cryptoKeys/state-$stack"

apply=false
for arg in "$@"; do
  case "$arg" in
    --apply) apply=true ;;
    *) echo "Unknown argument: $arg" >&2; exit 2 ;;
  esac
done

if [[ "${PULUMI_STACK:-}" != "$stack" ]]; then
  echo "Run under mise's env with PULUMI_STACK=$stack, so PULUMI_BACKEND_URL is prod's backend." >&2
  exit 1
fi
echo "Backend: $PULUMI_BACKEND_URL"
$apply || echo "Dry run: nothing changes. Pass --apply to perform the steps marked '+'."

run() {
  echo "+ $*"
  if $apply; then "$@"; fi
}

if pulumi stack ls --project portal --json 2>/dev/null | jq -e --arg s "$stack" 'any(.[]; .name == $s or (.name | endswith("/" + $s)))' >/dev/null; then
  echo "$dest_stack exists"
else
  # Pulumi.prod.yaml already names the secrets provider and holds the key, so init reuses them.
  run pulumi stack init "$dest_stack" --cwd "$here/../packages/infrastructure/src/portal" --secrets-provider "$secrets_provider" --no-select
fi

if pulumi stack export --stack "$source_stack" | jq -e --arg u "$urn" 'any(.deployment.resources[]; .urn == $u)' >/dev/null; then
  # The new stack has no gcp provider yet, so the move brings infrastructure's along.
  run pulumi state move --source "$source_stack" --dest "$dest_stack" --yes "$urn"
else
  echo "portal-a: already moved"
fi
