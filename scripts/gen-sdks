#!/usr/bin/env bash
# Generates the @pulumi/authentik SDK that packages/infrastructure depends on as a file: dependency.
# The output is committed, because Renovate's lockfile update runs `pnpm install` without this script
# (workplace#3); `mise run check` fails if it leaves a diff.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

provider_version="2026.8.0"
out_dir="packages/infrastructure/generated/authentik"

# The pulumi version is in the key so a CLI bump re-checks the patches below against new codegen.
key="$provider_version pulumi $(pulumi version)"
if [ "$(cat "$out_dir/.gen-key" 2>/dev/null)" = "$key" ]; then
  exit 0
fi

rm -rf "$out_dir"
mkdir -p "$(dirname "$out_dir")"

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT
pulumi package gen-sdk terraform-provider goauthentik/authentik "$provider_version" --language nodejs --local --out "$tmp_dir"

# Works around a pulumi 3.192 nodejs codegen bug for parameterized providers: these four imports
# come out with the wrong relative depth and fail the package's own postinstall `tsc` build.
perl -pi -e 's#"\./types/input"#"./input"#; s#"\./types/output"#"./output"#' "$tmp_dir/nodejs/types/input.ts" "$tmp_dir/nodejs/types/output.ts"
perl -pi -e 's#"\./utilities"#"../utilities"#' "$tmp_dir/nodejs/config/vars.ts" "$tmp_dir/nodejs/types/index.ts"

mv "$tmp_dir/nodejs" "$out_dir"
echo "$key" >"$out_dir/.gen-key"
