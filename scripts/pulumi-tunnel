#!/usr/bin/env bash
# Shared preamble for `pulumi up`/`pulumi preview` on the infrastructure stack: points
# pulumi-docker-build at podman, raises the db tunnel, then runs the pulumi command given
# as $1 (extra args in $2+) against ./packages/infrastructure.
set -euo pipefail

here="$(dirname "${BASH_SOURCE[0]}")"
cmd="$1"
shift

# pulumi-docker-build talks to a Docker API endpoint; point it at podman.
podman machine start 2>/dev/null || true
export DOCKER_HOST="$("$here/podman-docker-host")"

# The postgresql provider needs a route to Cloud SQL's private IP (#112). Raise the tunnel for
# the duration of the apply and tear it down afterwards, so this is automatic rather than a
# step someone has to remember.
# Output is captured rather than suppressed: tearing the tunnel down at EXIT makes the child
# report SIGTERM, which would print an error on a perfectly good run — but discarding it also
# threw away the reason a tunnel failed to open. Show it only when the wait loop gives up.
tunnel_log="$(mktemp)"
"$here/db-tunnel" >"$tunnel_log" 2>&1 &
tunnel=$!
trap 'kill $tunnel 2>/dev/null; wait $tunnel 2>/dev/null || true; rm -f "$tunnel_log"' EXIT

for i in $(seq 1 30); do
  nc -z localhost 5432 2>/dev/null && break
  if [ "$i" = 30 ]; then
    echo "db tunnel never came up:" >&2
    cat "$tunnel_log" >&2
    exit 1
  fi
  sleep 1
done

# --stack is explicit because pulumi stores the selected stack per directory path in
# ~/.pulumi/workspaces, so a fresh session worktree has none and the command would fail.
pulumi "$cmd" --cwd ./packages/infrastructure --stack "${PULUMI_STACK:-prod}" "$@"
