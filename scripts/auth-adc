#!/usr/bin/env bash
# Points Application Default Credentials at your own gcloud login, in the main checkout's .gcloud/
# so every worktree shares it.
set -euo pipefail

dir="$(dirname "$GOOGLE_APPLICATION_CREDENTIALS")"
mkdir -p "$dir"
CLOUDSDK_CONFIG="$dir" gcloud auth application-default login
CLOUDSDK_CONFIG="$dir" gcloud auth application-default set-quota-project cyc-admin-scripts
