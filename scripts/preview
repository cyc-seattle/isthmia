#!/usr/bin/env bash
# Shows the diff `mise run deploy` would apply to every project, without applying it.
set -euo pipefail

here="$(dirname "${BASH_SOURCE[0]}")"
pulumi preview --refresh --cwd "$here/../packages/infrastructure/src/bootstrap" --stack "${PULUMI_STACK:-prod}"
"$here/pulumi-tunnel" preview
pulumi preview --cwd "$here/../packages/infrastructure/src/authentik" --stack "${PULUMI_STACK:-prod}"
exec pulumi preview --cwd "$here/../packages/infrastructure/src/crm" --stack "${PULUMI_STACK:-prod}"
