#!/usr/bin/env bash
# Brings up dev/directus-local (with DIRECTUS_LICENSE_KEY, unlike `just directus-local`'s
# schema-only use), then runs the Community role's rules integration test
# (packages/infrastructure/integration/community-rules.test.ts) against it. Never skips: a missing
# license key fails loudly, both here and in the test itself (#166).
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [[ -z "${DIRECTUS_LICENSE_KEY:-}" ]]; then
  echo "DIRECTUS_LICENSE_KEY is required to run the Community rules integration test (never skipped) - see docs/manual-setup.md." >&2
  exit 1
fi

compose_file="dev/directus-local/docker-compose.yml"
project="isthmia-directus-community-test"

# colima and Docker Desktop need DOCKER_HOST pointed at their socket; on a native-Docker host
# (e.g. the GitHub Actions runner) this is a no-op and the system `docker` is used as-is.
if [[ -z "${DOCKER_HOST:-}" ]] && socket="$(./scripts/docker-host 2>/dev/null)"; then
  export DOCKER_HOST="$socket"
fi

compose() {
  docker compose -p "$project" -f "$compose_file" "$@"
}

# KEEP=1 leaves the stack running on exit, so repeated iteration while developing rules or fixtures
# re-uses the already-activated instance instead of tearing it down and re-activating the license
# fresh every run. The test's own fixture setup tolerates a container left over from a prior
# iteration; just re-run this script (or `pnpm exec vitest run --config vitest.integration.config.ts`
# directly, once the stack is up) as many times as needed, then a final `KEEP= ./scripts/directus-community-test`
# (or a plain re-run of this script) to tear down.
cleanup() {
  [[ -n "${KEEP:-}" ]] && return
  compose down --volumes
}
trap cleanup EXIT

compose up -d

echo "waiting for Directus to answer /server/ping..."
# A fresh database's migrations run well over a minute - generous enough to cover that,
# not just container start.
attempts=150
for i in $(seq 1 "$attempts"); do
  status="$(curl -s -o /dev/null -w '%{http_code}' http://localhost:8055/server/ping || true)"
  [[ "$status" == "200" ]] && break
  if [[ "$i" == "$attempts" ]]; then
    echo "Directus at http://localhost:8055 never became reachable" >&2
    compose logs directus | grep -v "PM2" >&2 || true
    exit 1
  fi
  sleep 2
done

if ! pnpm exec vitest run --config vitest.integration.config.ts; then
  echo "--- directus container logs (non-PM2) ---" >&2
  compose logs directus | grep -v "PM2" >&2 || true
  exit 1
fi
