#!/usr/bin/env bash
# Formatting, linting, and type checks: each package's src, its tests, and the Dockerfile manifest.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

pnpm exec prettier --check .
pnpm exec eslint .
pnpm run -r build
for f in packages/*/tsconfig.test.json tsconfig.test.json; do pnpm exec tsc -p "$f"; done
./scripts/dockerfile-packages
./scripts/gen-sdks
if [ -n "$(git status --porcelain -- packages/infrastructure/generated)" ]; then
  echo "scripts/gen-sdks changed packages/infrastructure/generated. Commit the result." >&2
  exit 1
fi
