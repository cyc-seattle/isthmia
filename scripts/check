#!/usr/bin/env bash
# Formatting, linting, and type checks: each package's src, its tests, and the Dockerfile manifest.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

treefmt --fail-on-change
pnpm exec eslint .
pnpm run -r build
for f in packages/*/tsconfig.test.json; do pnpm exec tsc -p "$f"; done
./scripts/dockerfile-packages
