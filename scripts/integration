#!/usr/bin/env bash
# Runs the integration features against dev: Playwright's browser journeys.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Here, not in `mise run install`, so CI's checks never download a browser. A runner also needs
# the browser's system libraries.
pnpm exec playwright install ${CI:+--with-deps} chromium
pnpm exec bddgen
pnpm exec playwright test
