#!/usr/bin/env bash
# Runs a pulumi command on each project deployed to $PULUMI_STACK. platform's backend stack holds what
# crm and the syncs did (cyc-seattle/workplace#6), and authentik reads Directus's OIDC client from it.
#
# For preview, it also appends each project's result, true if it has changes and false if not, to
# $DEPLOY_CHANGES_FILE when that's set. The org's deploy.yml reads it to skip a deploy that changes
# nothing.
set -euo pipefail

here="$(dirname "${BASH_SOURCE[0]}")"

# The docker-build provider records DOCKER_HOST in state, so a per-user socket path makes a deploy
# from another machine replace every image (#208). Unset, it builds on the first buildx builder it
# can reach.
unset DOCKER_HOST

case "$PULUMI_STACK" in
  dev) projects=(authentik portal) ;;
  prod) projects=(authentik portal) ;;
  *) echo "No projects deploy to stack '$PULUMI_STACK'." >&2; exit 1 ;;
esac

# A PR's deploy names only the projects it changed (scripts/changed-projects), still in this order.
if [[ -n "${DEPLOY_PROJECTS:-}" ]]; then
  for wanted in $DEPLOY_PROJECTS; do
    [[ " ${projects[*]} " == *" $wanted "* ]] || { echo "'$wanted' doesn't deploy to stack '$PULUMI_STACK'." >&2; exit 1; }
  done
  selected=()
  for project in "${projects[@]}"; do
    [[ " $DEPLOY_PROJECTS " == *" $project "* ]] && selected+=("$project")
  done
  projects=("${selected[@]}")
fi

# --stack is explicit because pulumi remembers the selected stack per directory, which a fresh
# worktree hasn't got.
if [[ "$1" != preview ]]; then
  for project in "${projects[@]}"; do
    pulumi "$1" --cwd "$here/../packages/infrastructure/src/$project" --stack "$PULUMI_STACK" "${@:2}"
  done
  exit 0
fi

out=$(mktemp)
trap 'rm -f "$out"' EXIT
for project in "${projects[@]}"; do
  status=0
  pulumi preview --cwd "$here/../packages/infrastructure/src/$project" --stack "$PULUMI_STACK" \
    --expect-no-changes "${@:2}" 2>&1 | tee "$out" || status=$?
  # --expect-no-changes fails both when there are changes and when the preview fails. Only Pulumi's
  # NoChangesExpectedError means changes; any other failure fails the task.
  if ((status == 0)); then
    changes=false
  elif grep -q 'no changes were expected.* but changes were proposed' "$out"; then
    changes=true
  else
    exit "$status"
  fi
  echo "$project: changes=$changes"
  if [[ -n "${DEPLOY_CHANGES_FILE:-}" ]]; then
    echo "$changes" >> "$DEPLOY_CHANGES_FILE"
  fi
done
