#!/usr/bin/env bash
# Moves prod's app resources out of `infrastructure`'s state into authentik, crm, clubspot-sync, and
# gsuite-sync (#231, docs/prod-state-move.md). Changes no cloud resource: it moves state, and
# re-imports the two postgresql databases as gcp.sql.Database. A dry run by default; `--apply`
# performs it. Re-runnable: each step skips what's already done. Ends with a preview of every project.
#
# Usage: move-prod-state [--apply] [--skip-preview]
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
projects_dir="$here/../packages/infrastructure/src"
stack=prod
source_stack="organization/infrastructure/$stack"
secrets_provider="gcpkms://projects/cyc-admin-scripts/locations/us-west1/keyRings/pulumi/cryptoKeys/state-$stack"

apply=false
preview=true
for arg in "$@"; do
  case "$arg" in
    --apply) apply=true ;;
    --skip-preview) preview=false ;;
    *) echo "Unknown argument: $arg" >&2; exit 2 ;;
  esac
done

if [[ "${PULUMI_STACK:-}" != "$stack" ]]; then
  echo "Run under mise's env with PULUMI_STACK=$stack, so PULUMI_BACKEND_URL is prod's backend." >&2
  exit 1
fi
echo "Backend: $PULUMI_BACKEND_URL"
$apply || echo "Dry run: nothing changes. Pass --apply to perform the steps marked 'run'."

# The docker-build provider records DOCKER_HOST in state (#208).
unset DOCKER_HOST

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

run() {
  echo "+ $*"
  if $apply; then "$@"; fi
}

export_state() {
  pulumi stack export --stack "organization/$1/$stack" --file "$work/$1.json"
}

stack_exists() {
  pulumi stack ls --project "$1" --json 2>/dev/null | jq -e --arg s "$stack" 'any(.[]; .name == $s or (.name | endswith("/" + $s)))' >/dev/null
}

# Each target's resources, by name. A Secret's RandomBytes and SecretVersion children move with it.
names() {
  case "$1" in
    authentik) echo "authentik-secret-key authentik-db-password authentik-bootstrap-token authentik-bootstrap-password directus-oidc-client-secret google-oauth-client-id google-oauth-client-secret authentik-user authentik-a" ;;
    crm) echo "directus-key directus-secret directus-db-password directus-admin-bootstrap-password directus-license-key clubspot-sync-directus-token gsuite-sync-directus-token directus-community-role-id directus-community-role-id-version directus-user directus-a" ;;
    clubspot-sync) echo "clubspot-username clubspot-password" ;;
    gsuite-sync) echo "enable-admin.googleapis.com enable-groupssettings.googleapis.com" ;;
  esac
}
targets=(authentik crm clubspot-sync gsuite-sync)

# URNs in the source's state for a target: the named resources, their children, and for crm, every
# Directus role and user (the only dynamic resources in `infrastructure`).
urns_for() {
  local target="$1"
  jq -r --arg names "$(names "$target")" --arg target "$target" '
    ($names | split(" ")) as $n
    | def name: split("::")[3];
      .deployment.resources[]
      | select(
          ((.urn | name) as $u | $n | index($u))
          or ((.parent // "" | name) as $p | $p != null and ($n | index($p)) and (.parent | test("::gcp:secretmanager/secret:Secret::")))
          or ($target == "crm" and .type == "pulumi-nodejs:dynamic:Resource")
        )
      | select(.type | startswith("pulumi:providers:") | not)
      | .urn' "$work/infrastructure.json"
}

# `pulumi state move` reuses a provider already in the destination only if its recorded inputs are
# equal, and otherwise refuses. A default provider's inputs are the stack's config, so they differ
# between projects. Records the source's inputs on the destination's provider, which changes no
# resource: the next update records the destination's own again.
align_providers() {
  local target="$1"
  shift
  local urns_json
  urns_json="$(printf '%s\n' "$@" | jq -R . | jq -s .)"
  if ! $apply; then
    echo "  (with --apply: align $target's default providers' recorded inputs with infrastructure's, if they differ)"
    return
  fi
  export_state "$target"
  if jq -e '(.deployment.resources // []) | length == 0' "$work/$target.json" >/dev/null; then
    return
  fi
  jq --argjson urns "$urns_json" --arg target "$target" --slurpfile dest "$work/$target.json" '
    def dest_urn: sub("::infrastructure::"; "::" + $target + "::");
    [.deployment.resources[] | select(.urn as $u | $urns | index($u)) | .provider // empty
      | sub("::[^:]*$"; "")] as $used
    | [.deployment.resources[] | select(.urn as $u | $used | index($u)) | {urn: (.urn | dest_urn), inputs}] as $source
    | $dest[0]
    | .deployment.resources |= map(
        . as $r
        | ([$source[] | select(.urn == $r.urn) | .inputs] | first) as $inputs
        | if $inputs != null and $inputs != $r.inputs then .inputs = $inputs else . end
      )' "$work/infrastructure.json" >"$work/$target.aligned.json"
  if jq -e --slurpfile a "$work/$target.aligned.json" '. == $a[0]' "$work/$target.json" >/dev/null; then
    return
  fi
  echo "+ pulumi stack import --stack organization/$target/$stack (provider inputs aligned)"
  pulumi stack import --stack "organization/$target/$stack" --file "$work/$target.aligned.json"
}

echo
echo "== Stacks"
for target in "${targets[@]}"; do
  if stack_exists "$target"; then
    echo "organization/$target/$stack exists"
  else
    # Pulumi.prod.yaml already names the secrets provider and holds the key, so init reuses them.
    run pulumi stack init "organization/$target/$stack" --cwd "$projects_dir/$target" --secrets-provider "$secrets_provider" --no-select
  fi
done

export_state infrastructure

echo
echo "== Moves from $source_stack"
for target in "${targets[@]}"; do
  urns=()
  while IFS= read -r urn; do urns+=("$urn"); done < <(urns_for "$target")
  if ((${#urns[@]} == 0)); then
    echo "$target: nothing left to move"
    continue
  fi
  echo "$target: ${#urns[@]} resources"
  align_providers "$target" "${urns[@]}"
  run pulumi state move --source "$source_stack" --dest "organization/$target/$stack" --yes "${urns[@]}"
done

echo
echo "== Databases: postgresql.Database -> gcp.sql.Database"
# Re-read: the moves changed the source.
$apply && export_state infrastructure
for target in authentik crm; do
  case "$target" in
    authentik) db=authentik ;;
    crm) db=directus ;;
  esac
  export_state "$target" 2>/dev/null || echo '{"deployment":{"resources":[]}}' >"$work/$target.json"
  instance="$(jq -r --arg u "$db-user" '[.deployment.resources[] | select(.urn | endswith("::gcp:sql/user:User::" + $u)) | .outputs.instance][0] // empty' "$work/$target.json" "$work/infrastructure.json" | head -1)"
  if [[ -z "$instance" ]]; then
    echo "Can't find $db-user's instance in $target's or infrastructure's state." >&2
    exit 1
  fi
  if jq -e --arg u "$db-db" 'any(.deployment.resources[]; .urn | endswith("::gcp:sql/database:Database::" + $u))' "$work/$target.json" >/dev/null; then
    echo "$target: $db-db already imported"
  else
    # Protected, as the code declares it. --generate-code=false: the code already declares it.
    run pulumi import gcp:sql/database:Database "$db-db" "projects/cyc-admin-scripts/instances/$instance/databases/$db" \
      --cwd "$projects_dir/$target" --stack "$stack" --generate-code=false --yes
  fi
  # An import records the provider's default deletion policy, DELETE. The code says ABANDON, which
  # lives only in state, so record it there instead of an update that would call the Admin API.
  if $apply; then
    export_state "$target"
    jq --arg u "$db-db" '.deployment.resources |= map(
        if (.urn | endswith("::gcp:sql/database:Database::" + $u))
        then .inputs.deletionPolicy = "ABANDON" | .outputs.deletionPolicy = "ABANDON" else . end
      )' "$work/$target.json" >"$work/$target.abandon.json"
    if ! jq -e --slurpfile a "$work/$target.abandon.json" '. == $a[0]' "$work/$target.json" >/dev/null; then
      echo "+ pulumi stack import --stack organization/$target/$stack ($db-db's deletionPolicy: ABANDON)"
      pulumi stack import --stack "organization/$target/$stack" --file "$work/$target.abandon.json"
    fi
  else
    echo "  (with --apply: record $db-db's deletionPolicy as ABANDON in $target's state)"
  fi
  for urn in "urn:pulumi:$stack::infrastructure::postgresql:index/database:Database::$db" \
    "urn:pulumi:$stack::infrastructure::pulumi:providers:postgresql::$db-db"; do
    if jq -e --arg u "$urn" 'any(.deployment.resources[]; .urn == $u)' "$work/infrastructure.json" >/dev/null; then
      # Only from state: the database itself stays as it is.
      run pulumi state delete --stack "$source_stack" --yes "$urn"
    else
      echo "$urn: already gone"
    fi
  done
done

if ! $preview; then
  exit 0
fi
if ! $apply; then
  echo
  echo "Previews run after --apply: before the move, they'd preview this code against the old state."
  exit 0
fi

echo
echo "== Previews"
for project in infrastructure "${targets[@]}"; do
  echo
  echo "--- $project"
  pulumi preview --cwd "$projects_dir/$project" --stack "$stack" --diff
done
