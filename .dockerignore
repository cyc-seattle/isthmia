# Only what the portal's Dockerfile copies. Anything else in the context changes the image's context
# hash, so a commit that touches only infrastructure, scripts, or docs would rebuild it.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!tsconfig.json
!packages/*/package.json
!packages/portal/

# Recreated inside the image; excluded so an explicit `COPY packages/<name>/` in the Dockerfile
# doesn't sweep in a local build's artifacts.
**/node_modules
**/dist
**/*.tsbuildinfo
