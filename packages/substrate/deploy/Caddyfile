# Caddy config for the substrate VM: the single public listener, for the CRM (Directus) only.
# Authentik (login.*) and the portal (cycsail.team) run on the cluster (#231).
#
# directus.* (DIRECTUS_DOMAIN): Directus authenticates via its own native OIDC and enforces its own
# roles/permissions server-side, so this is a plain reverse proxy. The domain comes from the compose
# environment so the same image works for any domain.

{$DIRECTUS_DOMAIN} {
	reverse_proxy directus:8055
}
