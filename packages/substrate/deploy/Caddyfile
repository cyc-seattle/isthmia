# Caddy config for the substrate VM: the single public listener fronting every surface, routed by
# hostname.
#
# cycsail.team (SITE_DOMAIN): every request is gated by Authentik's embedded forward-auth outpost —
# reaching the static files at all IS the authentication check. Which sections of the page a
# visitor then sees is a second, per-section decision the portal's own HTML makes at render time
# (`packages/portal`), via a `templates` condition on the `staff` group in the outpost's
# `X-Authentik-Groups` header — so this block also serves the page through Caddy's `templates`
# handler rather than a plain `file_server`.
#
# directus.* (DIRECTUS_DOMAIN): the CRM's data layer (Directus itself — an admin screen, not
# customer-facing). No forward-auth gate here — Directus authenticates via its own native OIDC
# and enforces its own roles/permissions server-side, so this is a plain reverse proxy.
#
# login.* (LOGIN_DOMAIN): Authentik, the platform's identity provider. Also a plain reverse
# proxy — Authentik enforces its own login server-side, same as Directus above.
#
# Every domain is provided by the compose environment so the same image works for any domain.

{$DIRECTUS_DOMAIN} {
	reverse_proxy directus:8055
}

{$LOGIN_DOMAIN} {
	# Authentik's own "Go home" button (shown on a denied or ended sign-in) links to `/`, which its
	# RootRedirectView sends on to `/if/user/` — its application dashboard, empty and useless to a
	# family with no apps assigned. Send both to the portal's own public landing page instead.
	redir /if/user/ https://{$SITE_DOMAIN}/welcome 302
	redir / https://{$SITE_DOMAIN}/welcome 302

	reverse_proxy authentik-server:9000
}

{$SITE_DOMAIN} {
	# Public and unauthenticated: where Authentik's login domain sends a visitor whose sign-in was
	# denied or ended, so it must not depend on the forward-auth check below.
	handle /welcome {
		root * /srv
		rewrite * /welcome.html
		file_server
	}
	handle /welcome.html {
		root * /srv
		file_server
	}

	# Authentik's outpost sets these on a successful forward-auth request below; strip anything a
	# client sent itself first, so a forged header can never fake a signed-in identity or group.
	request_header -X-Authentik-Username
	request_header -X-Authentik-Groups
	request_header -X-Authentik-Email

	# The embedded outpost's own endpoints for this app (its sign-in redirect, logout, callback)
	# live under this path, on the protected app's own domain — Authentik's documented shape for a
	# forward-auth proxy provider.
	handle /outpost.goauthentik.io/* {
		reverse_proxy authentik-server:9000
	}

	handle {
		# Ask the embedded outpost whether this request is signed in at all. Group membership (and
		# so which sections of the page render) is decided per-section below, by the portal's own
		# `templates` condition on X-Authentik-Groups — not by this check.
		forward_auth authentik-server:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email

			@unauthenticated status 401
			handle_response @unauthenticated {
				redir * /outpost.goauthentik.io/start?rd={scheme}://{host}{uri}
			}
		}

		root * /srv
		templates
		file_server
	}
}
